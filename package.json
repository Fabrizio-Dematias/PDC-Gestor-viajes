{
  "name": "gestor-viajes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:back": "VITE_API_URL=http://localhost:4000 vite",
    "dev:back:sur": "VITE_API_URL=http://localhost:4000 VITE_AGENCIA_ID=ag-sur vite --port 5174",
    "back": "node --env-file-if-exists=.env servidor/arrancar.mjs",
    "back:vuelos": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning servidor/vuelos/index.js",
    "back:hospedaje": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning servidor/hospedaje/index.js",
    "back:traslado": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning servidor/traslado/index.js",
    "back:usuarios": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning servidor/usuarios/index.js",
    "back:agregador": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning servidor/agregador/index.js",
    "back:nodo-agencia": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning servidor/nodo-agencia/index.js",
    "matar": "node servidor/matar.mjs",
    "infra:up": "docker compose -f docker-compose.central.yml up -d postgres redis",
    "infra:down": "docker compose -f docker-compose.central.yml down",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node pruebas/humo-fallos.mjs",
    "test:back": "node pruebas/humo-backend.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "redis": "^6.2.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
