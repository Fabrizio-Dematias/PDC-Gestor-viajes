# Sin esta variable el front usa el servidor mock en memoria
# (src/api/mock/servidor.js). Al definirla, cliente.js pasa a hacer fetch
# real contra el agregador. Ningún otro archivo cambia.
# VITE_API_URL=http://localhost:8080

# --- Nodo central: Postgres (usuarios/agregador) ---
# Por defecto, el contenedor de docker-compose.central.yml.
PGHOST=localhost
PGPORT=5432
PGDATABASE=gestor_viajes
PGUSER=gestor
PGPASSWORD=gestor
# PGSSL=false

# Alternativa: Postgres alojado en Supabase, en vez del contenedor de
# arriba (comentar el bloque de arriba y descomentar este). Los datos
# salen del panel del proyecto en supabase.com → Project Settings →
# Database → Connection parameters. Usar el puerto 5432 (conexión
# directa) para desarrollo; el 6543 (pooler) es para serverless con
# muchas conexiones cortas, que no es este caso — acá cada servicio
# abre un pool de conexiones largo, una sola vez.
# PGHOST=db.<project-ref>.supabase.co
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPASSWORD=<la contraseña del proyecto>
# PGSSL=true

# --- Nodo central: Redis (caché + circuit breaker del agregador) ---
REDIS_URL=redis://localhost:6379

# --- Presupuesto agregador → usuarios (servidor/agregador/index.js) ---
# Por defecto 1200ms, pensado para Postgres local. Con Postgres alojado
# (Supabase u otro) el round-trip de red solo puede superar eso; subir
# a ~3000 en ese caso (ver servidor/comun/config.js → timeouts.contexto).
# TIMEOUT_CONTEXTO_MS=3000

# --- Sesión (servidor/comun/jwt.js, sólo la usa el agregador) ---
# Sin esta variable arranca con un secreto de desarrollo (avisa por
# consola). Fijar uno propio para cualquier cosa que no sea local.
# JWT_SECRET=
# JWT_TTL_SEG=604800

# --- Nodo de cómputo: vertical nuevo ---
# PUERTO_TRASLADO=4004
# URL_TRASLADO=http://localhost:4004

# --- Proveedor externo de vuelos (docs/proveedor-externo.md) ---
# Por defecto `ficticio` (base propia). `amadeus` y `duffel` pegan
# contra la API real correspondiente — sólo cambia esta variable, el
# resto del sistema no se entera.
# PROVEEDOR=duffel

# Amadeus (Self-Service cerró su portal el 17/07/2026 — queda el código,
# sin cuenta activa para probarlo).
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=

# Duffel (duffel.com) — cuenta gratuita, token de test desde
# Dashboard → Developers → Access tokens. `return_offers=true` en la
# request hace que la búsqueda sea síncrona (sin polling).
# DUFFEL_ACCESS_TOKEN=duffel_test_...

# --- Nodo de agencia ---
# Con qué agencia arranca esta instancia de nodo-agencia (debe existir
# en la tabla `agencias` del central: ag-demo o ag-sur por defecto).
# AGENCIA_ID=ag-demo
# PUERTO_NODO_AGENCIA=4100
# A qué agregador le sincroniza la bitácora local.
# URL_AGREGADOR=http://localhost:4000

# Con qué agencia arranca el front (marca blanca) y a qué nodo de
# agencia le manda la bitácora fire-and-forget de cada búsqueda.
# VITE_AGENCIA_ID=ag-demo
# VITE_URL_NODO_AGENCIA=http://localhost:4100
