# Sin esta variable el front usa el servidor mock en memoria
# (src/api/mock/servidor.js). Al definirla, cliente.js pasa a hacer fetch
# real contra el agregador. Ningún otro archivo cambia.
# VITE_API_URL=http://localhost:8080

# --- Nodo central: Postgres (usuarios/agregador) ---
# Por defecto, el contenedor de docker-compose.central.yml.
PGHOST=localhost
PGPORT=5432
PGDATABASE=gestor_viajes
PGUSER=gestor
PGPASSWORD=gestor
# PGSSL=false

# Alternativa: Postgres alojado en Supabase, en vez del contenedor de
# arriba (comentar el bloque de arriba y descomentar este). Los datos
# salen del panel del proyecto en supabase.com → Project Settings →
# Database → Connection parameters. Usar el puerto 5432 (conexión
# directa) para desarrollo; el 6543 (pooler) es para serverless con
# muchas conexiones cortas, que no es este caso — acá cada servicio
# abre un pool de conexiones largo, una sola vez.
# PGHOST=db.<project-ref>.supabase.co
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPASSWORD=<la contraseña del proyecto>
# PGSSL=true

# Con PGSSL=true se verifica el certificado del servidor contra la CA de
# Supabase (servidor/certificados/). Para otro Postgres alojado, su CA:
# PGSSLROOTCERT=/ruta/a/su-ca.crt

# --- Cifrado en tránsito entre componentes (docs/informe-amenazas.md) ---
# Primero: npm run tls:certs  (CA propia + un certificado por servicio,
# en certs/, fuera del repo). Con TLS=on todos los servicios escuchan
# en https:// y los internos exigen certificado de cliente (TLS mutuo).
# El front: npm run dev:back:tls. El navegador tiene que confiar en
# certs/ca.crt (ver el informe).
# TLS=on
# TLS_DIR=certs

# --- Nodo central: Redis (caché + circuit breaker del agregador) ---
REDIS_URL=redis://localhost:6379

# --- Presupuesto agregador → usuarios (servidor/agregador/index.js) ---
# Por defecto 1200ms, pensado para Postgres local. Con Postgres alojado
# (Supabase u otro) el round-trip de red solo puede superar eso; subir
# a ~3000 en ese caso (ver servidor/comun/config.js → timeouts.contexto).
# TIMEOUT_CONTEXTO_MS=3000

# --- Sesión (servidor/comun/jwt.js, sólo la usa el agregador) ---
# Sin esta variable arranca con un secreto de desarrollo (avisa por
# consola). Fijar uno propio para cualquier cosa que no sea local.
# JWT_SECRET=
# JWT_TTL_SEG=604800

# --- Dónde se guardan las bases SQLite de cada servicio ---
# Por defecto, en servidor/<servicio>/datos/. Con esto, en
# $DATOS_DIR/<servicio>/: sirve para correr las pruebas (que reservan
# asientos y mandan avisos) sin ensuciar las bases de la demostración.
# DATOS_DIR=/tmp/gestor-viajes-pruebas

# --- Pool de Postgres (servidor/comun/config.js → postgres) ---
# Con la base en Supabase abrir una conexión nueva cuesta ~1,5 s (TLS +
# pooler) contra ~0,25 s de una consulta en una ya abierta, así que el
# pool mantiene una abierta y la deja vivir 5 minutos. Se cambia sólo si
# hace falta.
# PG_MIN=1
# PG_IDLE_MS=300000
# PG_CONNECT_MS=8000

# --- Nodo de cómputo: vertical nuevo ---
# PUERTO_TRASLADO=4004
# URL_TRASLADO=http://localhost:4004

# --- Proveedor externo de vuelos (docs/proveedor-externo.md) ---
# Por defecto `ficticio` (base propia). `amadeus` y `duffel` pegan
# contra la API real correspondiente — sólo cambia esta variable, el
# resto del sistema no se entera.
# PROVEEDOR=duffel

# Amadeus (Self-Service cerró su portal el 17/07/2026 — queda el código,
# sin cuenta activa para probarlo).
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=

# Duffel (duffel.com) — cuenta gratuita, token de test desde
# Dashboard → Developers → Access tokens. `return_offers=true` en la
# request hace que la búsqueda sea síncrona (sin polling).
# DUFFEL_ACCESS_TOKEN=duffel_test_...

# --- Canal asíncrono de reservas (Módulo 3) ---
# El agregador publica `reserva_confirmada` en un stream de Redis y este
# servicio, aparte, lo consume y "envía" la confirmación. Mismo Redis de
# arriba (REDIS_URL).
# PUERTO_NOTIFICACIONES=4005
# URL_NOTIFICACIONES=http://localhost:4005
# STREAM_RESERVAS=reservas:eventos
# GRUPO_NOTIFICACIONES=notificaciones
# Un mensaje leído y no confirmado (XACK) más de este tiempo se reclama:
# COLA_RECLAMAR_MS=3000

# --- Registro de servicios (Módulo 4) ---
# Cada servicio se anota acá al arrancar y el agregador descubre las
# instancias sanas por nombre, en vez de usar sólo las URL_* de arriba
# (que quedan como respaldo si el registro no responde).
# PUERTO_REGISTRO=4006
# URL_REGISTRO=http://localhost:4006
# REGISTRO=off                 # no anotarse ni descubrir: sólo direcciones fijas
# Para levantar una segunda instancia de un servicio (otro puerto, mismo
# registro):  PUERTO_VUELOS=4011 INSTANCIA_ID=vuelos@4011 npm run back:vuelos
# URL_PROPIA=http://vuelos:4001   # cómo la ven los demás (en Docker, el nombre del servicio)
# REGISTRO_TTL_MS=10000        # una instancia sin latido durante este tiempo se da de baja
# REGISTRO_CHEQUEO_MS=2000     # cada cuánto se consulta /salud/ready de cada instancia

# --- Presupuestos de tiempo (docs/contrato-agregador.md §3) ---
# Agregador → vertical. Con PROVEEDOR=duffel o amadeus, vuelos espera 5,5 s
# (la API externa tarda 1,5–3,5 s); el agregador debe ver el mismo
# PROVEEDOR que el servicio de vuelos para deducirlo.
# TIMEOUT_VERTICAL_MS=2500      # hospedaje y traslado
# TIMEOUT_VUELOS_MS=2500        # por defecto 5500 con duffel o amadeus
# TIMEOUT_DUFFEL_MS=5000        # vuelos → API de Duffel

# --- Nodo de agencia ---
# Con qué agencia arranca esta instancia de nodo-agencia (debe existir
# en la tabla `agencias` del central: ag-demo o ag-sur por defecto).
# AGENCIA_ID=ag-demo
# PUERTO_NODO_AGENCIA=4100
# A qué agregador le sincroniza la bitácora local.
# URL_AGREGADOR=http://localhost:4000

# Con qué agencia arranca el front (marca blanca) y a qué nodo de
# agencia le manda la bitácora fire-and-forget de cada búsqueda.
# VITE_AGENCIA_ID=ag-demo
# VITE_URL_NODO_AGENCIA=http://localhost:4100
